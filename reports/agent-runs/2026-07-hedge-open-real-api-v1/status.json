  "scope_decisions": {
    "recorded_from_user_at": "2026-07-23T13:55:36+08:00",
    "real_post_adapter_in_stage": true,
    "numeric_risk_caps": "none; the operator controls exposure through entered order amount, attempt count, and margin allocation",
    "forward_fill_mismatch_numeric_tolerance": "none; a both-filled mismatch is recorded but does not by itself trigger a numeric-threshold pause",
    "fill_and_residual_policy": "actual filled quantities, values, residuals, partial states, and prior unresolved attempts are persisted and queried but do not gate the next immediate scheduled pair",
    "order_acceptance_and_reconciliation": "a returned orderId is accepted-order evidence; persist it and query to terminal state; timeout/missing response first queries deterministic client order ID and never blindly resends",
    "immediate_cadence": "each running task card owns an independent asynchronous scheduler that submits one concurrent hedge pair every 1 second; multiple tasks may submit in the same second; order-status tracking runs independently and does not block that task's next pair",
    "confirmed_failure_pause": "configurable consecutive_failure_pause_threshold defaults to 3; reaching it pauses further opening; a successful accepted pair resets the counter",
    "fill_accounting": "persist cumulative actual base and quote quantities per leg and calculate weighted average price as cumulative quote divided by cumulative base; data is audit/display only in this stage",
    "smooth_mode": "deferred to a separate next stage; each future smooth task will own its own WebSocket price-spread monitor and trigger only when its own spread-rate condition is met",
    "forward_spot_market_buy_working_rule": "send base quantity q_common, not quoteOrderQty; fixed base quantity is the frontend input and both hedge legs submit it concurrently",
    "forward_execution_policy": "concurrent; persist one attempt before both POSTs, then submit two fixed-q_common legs concurrently",
    "input_semantics": "single_amount is fixed base-asset quantity per attempt and target_n is number of attempts",
    "decimal_contract": "spot and UM quantities and preflight price/notional estimates have independent decimal/filter rules; use Decimal fixed-point and per-leg formatting",
    "account_contract": "regular Portfolio Margin as documented in the repository PRD; PM-Pro is out of this stage unless the user corrects this assumption"
