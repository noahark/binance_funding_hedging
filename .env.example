# Copy this file to `.env` for local runtime configuration.
# Keep the real `.env` out of git. The repository .gitignore already excludes it.

# Default Binance credentials for private reads and all signed write clients.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRIVATE_CHANNEL_ENABLED=false

# Optional paired overrides. Omit both values to use the default pair above.
# Do not use ${BINANCE_API_KEY} aliases: Docker --env-file does not expand them.
BINANCE_BORROW_API_KEY=
BINANCE_BORROW_API_SECRET=
BINANCE_HEDGE_API_KEY=
BINANCE_HEDGE_API_SECRET=

# Binance private-channel runtime knobs.
BINANCE_RECV_WINDOW=10000
BINANCE_PRIVATE_CHANNEL_TTL_SECONDS=1800
BINANCE_PRIVATE_CHANNEL_FAST_TTL_SECONDS=60
BINANCE_BORROW_CHECK_MAX_CALLS=50

# App runtime.
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8787
# Required together when APP_BIND_HOST is not loopback. Use only behind HTTPS.
APP_UI_USERNAME=
APP_UI_PASSWORD=
APP_OFFLINE=false
APP_CACHE_TTL_SECONDS=60
APP_REQUEST_TIMEOUT=15

# Optional offline fixture override, normally unused.
# APP_OFFLINE_RAW_DIR=reports/api-samples/public-market-contract-v2/20260703T051738Z/raw
