{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.binance-funding-hedging/schemas/api/public-market/snapshot.schema.json",
  "title": "Public Market Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "data_time",
    "source_sample_id",
    "summary",
    "rows",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "public-market-snapshot/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_time": {
      "type": "string",
      "format": "date-time"
    },
    "source_sample_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "route_counts",
        "asset_tag_counts",
        "negative_funding_status_counts"
      ],
      "properties": {
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "route_counts": {
          "$ref": "#/$defs/counts"
        },
        "asset_tag_counts": {
          "$ref": "#/$defs/counts"
        },
        "negative_funding_status_counts": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "private_channel": {
      "type": "string",
      "enum": ["enabled", "disabled"]
    },
    "sort_basis": {
      "type": "string",
      "enum": ["net_daily_yield", "abs_daily_funding_rate"]
    },
    "private_account": {
      "$ref": "#/$defs/private_account"
    },
    "borrow_validation": {
      "$ref": "#/$defs/borrow_validation_summary"
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "base_asset",
        "quote_asset",
        "asset_tag",
        "asset_tag_source",
        "asset_tag_confidence",
        "route_class",
        "positive_funding_enabled",
        "negative_funding_status",
        "futures",
        "spot",
        "margin_public",
        "funding_history",
        "ui_flags"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "base_asset": {
          "type": "string",
          "minLength": 1
        },
        "quote_asset": {
          "const": "USDT"
        },
        "asset_tag": {
          "enum": [
            "CRYPTO",
            "BSTOCK",
            "METAL",
            "UNKNOWN"
          ]
        },
        "asset_tag_source": {
          "type": "string",
          "minLength": 1
        },
        "asset_tag_confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "route_class": {
          "enum": [
            "MARGIN_SPOT_CANDIDATE",
            "SPOT_ONLY_CANDIDATE",
            "PERP_ONLY_EXCLUDED"
          ]
        },
        "positive_funding_enabled": {
          "type": "boolean"
        },
        "negative_funding_status": {
          "enum": [
            "PRIVATE_BORROW_VALIDATION_REQUIRED",
            "DISABLED_BSTOCK",
            "DISABLED_SPOT_ONLY",
            "DISABLED_PERP_ONLY"
          ]
        },
        "futures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbol",
            "status",
            "contract_type",
            "mark_price",
            "index_price",
            "last_funding_rate",
            "next_funding_time",
            "min_notional",
            "step_size"
          ],
          "properties": {
            "symbol": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "contract_type": {
              "type": "string"
            },
            "mark_price": {
              "$ref": "#/$defs/decimal_string"
            },
            "index_price": {
              "$ref": "#/$defs/decimal_string"
            },
            "last_funding_rate": {
              "$ref": "#/$defs/decimal_string"
            },
            "next_funding_time": {
              "type": "integer",
              "minimum": 0
            },
            "min_notional": {
              "$ref": "#/$defs/decimal_string"
            },
            "step_size": {
              "$ref": "#/$defs/decimal_string"
            }
          }
        },
        "spot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbol",
            "status",
            "exists",
            "min_notional",
            "step_size"
          ],
          "properties": {
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "base_asset": {
              "type": [
                "string",
                "null"
              ],
              "description": "Resolved spot leg's base asset (SNXXB for a bStock, BONK for 1000BONKUSDT) — single-point truth shared with the positions merge (2026-08-07 unified-resolver)."
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "exists": {
              "type": "boolean"
            },
            "match_type": {
              "type": ["string", "null"],
              "enum": ["exact_symbol", "bstock_b_suffix_alias", "multiplier_strip_alias", null]
            },
            "min_notional": {
              "anyOf": [
                {
                  "$ref": "#/$defs/decimal_string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "step_size": {
              "anyOf": [
                {
                  "$ref": "#/$defs/decimal_string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "margin_public": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public_cross_margin_pair",
            "source"
          ],
          "properties": {
            "public_cross_margin_pair": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "source": {
              "type": "string"
            }
          }
        },
        "collateral_cap": {
          "description": "Platform collateral-cap (maxCollateralExceededAsset) state for the row's resolved SPOT base asset (v0.9, stage 2026-08-02-spot-order-routing-cap-display-v1). Optional: legacy rows without the key still validate; the producer always emits it. exceeded=true = the asset is on the platform cap list; false = read succeeded and not on it; null = the read failed (unknown) OR the row has no tradable spot leg (see asset). checked_at is the platform-level read completion time, shared by every row in a snapshot (null on failure). asset is the resolved spot base asset (TSLAB for a bStock, never the contract TSLA); null only when the row has no tradable spot leg. Direction is NOT consulted. Display-only: never drives routing, sorting, filtering, or open/borrow gating.",
          "type": "object",
          "additionalProperties": false,
          "required": ["exceeded", "asset", "checked_at"],
          "properties": {
            "exceeded": {
              "type": ["boolean", "null"]
            },
            "asset": {
              "type": ["string", "null"]
            },
            "checked_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "funding_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "funding_time",
              "funding_rate"
            ],
            "properties": {
              "funding_time": {
                "type": "integer",
                "minimum": 0
              },
              "funding_rate": {
                "$ref": "#/$defs/decimal_string"
              }
            }
          }
        },
        "ui_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "funding_interval_hours": {
          "type": "integer",
          "enum": [1, 4, 8]
        },
        "daily_funding_rate": {
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "funding_sum_24h": {
          "description": "Settled funding-rate sum over the inclusive last 24h window [data_time-24h, data_time]. Not annualized. Null when the window is empty or data_time unknown.",
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "annualized_funding_24h": {
          "description": "Estimate-derived 24h annualization (daily_funding_rate * 365), or null when the daily rate is null. Settled history never mixes in.",
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "annualized_funding_7d": {
          "description": "Settled 7-day calendar-window funding-rate sum * (365 / 7), or null for an empty window. Estimate/lastFundingRate never mixes in.",
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "annualized_funding_30d": {
          "description": "Settled 30-day calendar-window funding-rate sum * (365 / 30), or null for an empty window.",
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "net_daily_yield": {
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "borrow_rate_source": {
          "type": ["string", "null"],
          "enum": [
            "next_hourly",
            "rate_history",
            "cross_margin_tier",
            "vip0_reference",
            null
          ]
        },
        "borrow_validation": {
          "$ref": "#/$defs/borrow_validation"
        },
        "opening_quotes": {
          "description": "Additive row-level opening quotes (2026-07-bookticker-open-columns-v1). Optional: legacy rows may omit the whole object and still validate; the current producer always emits a complete object. *_spread_pct are already-multiplied PERCENTAGE-POINT decimal strings (e.g. \"-0.04\" means -0.04%), NOT fractional rates — do NOT multiply by 100 again. About-60s public reference quotes, not an execution guarantee; last-good is publishable for at most ~2 cycles (default 120s) before status goes stale.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "updated_at",
            "spot_bid_price",
            "spot_ask_price",
            "futures_bid_price",
            "futures_ask_price",
            "forward_spread_pct",
            "reverse_spread_pct"
          ],
          "properties": {
            "status": {
              "enum": ["fresh", "incomplete", "stale", "unavailable"]
            },
            "updated_at": {
              "description": "UTC completion time of the most recent successful paired bookTicker fetch; null only when the pair never succeeded (unavailable). Retained on stale.",
              "type": ["string", "null"],
              "format": "date-time"
            },
            "spot_bid_price": {
              "description": "Spot best bid (reverse numerator left operand), or null when missing/zero/non-string.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "spot_ask_price": {
              "description": "Spot best ask (forward denominator / subtrahend), or null when missing/zero/non-string.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "futures_bid_price": {
              "description": "Futures best bid (forward minuend), or null when missing/zero/non-string.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "futures_ask_price": {
              "description": "Futures best ask (reverse denominator / subtrahend), or null when missing/zero/non-string.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "forward_spread_pct": {
              "description": "(futures_bid - spot_ask) / spot_ask * 100, ROUND_HALF_UP to 2 places, percentage-point decimal string (no '%' char); null when that direction's operands are not both valid >0.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "reverse_spread_pct": {
              "description": "(spot_bid - futures_ask) / futures_ask * 100, ROUND_HALF_UP to 2 places, percentage-point decimal string (no '%' char); null when that direction's operands are not both valid >0.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "borrow_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "classic_margin", "portfolio_account", "checked_at", "error"],
      "properties": {
        "verified": { "type": "boolean" },
        "classic_margin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pair_listed", "asset_borrowable", "daily_interest_vip0", "daily_interest_account", "user_min_borrow", "user_min_borrow_value_usdt", "source"],
          "properties": {
            "pair_listed": { "type": ["boolean", "null"] },
            "asset_borrowable": { "type": ["boolean", "null"] },
            "daily_interest_vip0": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "daily_interest_account": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "user_min_borrow": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "user_min_borrow_value_usdt": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "source": { "type": "string" }
          }
        },
        "portfolio_account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_borrowable", "borrow_limit", "error_code", "max_borrowable_value_usdt", "source"],
          "properties": {
            "max_borrowable": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "borrow_limit": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "error_code": { "type": ["string", "null"] },
            "max_borrowable_value_usdt": { "type": ["string", "null"] },
            "source": { "type": "string" }
          }
        },
        "checked_at": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "private_account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "balances_unified",
        "balances_spot",
        "um_positions",
        "total_value_usdt",
        "valuation",
        "checked_at",
        "error",
        "source_checked_at",
        "unavailable_sources"
      ],
      "properties": {
        "verified": { "type": "boolean" },
        "balances_unified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset", "total_balance", "cross_margin_borrowed"],
            "properties": {
              "asset": { "type": "string" },
              "total_balance": {
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              },
              "cross_margin_free": {
                "description": "Unencumbered PM full-cross balance from papi balance.crossMarginFree (raw decimal string | null). Additive/optional: frozen pre-2026-08 samples omit it. Display-only availability — NOT a max-transferable quote (a transfer out must also clear uniMMR / collateral constraints) and never added into total_value_usdt.",
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              },
              "cross_margin_locked": {
                "description": "PM full-cross locked quantity from papi balance.crossMarginLocked (raw decimal string | null). Additive/optional for frozen older samples; display/validation-only and never added into total_value_usdt.",
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              },
              "cross_margin_borrowed": {
                "description": "PM full-cross margin liability from papi balance.crossMarginBorrowed (raw decimal string | null).",
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              },
              "value_usdt": {
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              },
              "cross_margin_borrowed_value_usdt": {
                "description": "Backend-computed ≈USDT value of cross_margin_borrowed (8dp string | null). Display-only liability; null/blank/zero borrow -> 0.00000000; invalid amount or non-zero missing price -> null. Not included in total_value_usdt.",
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "balances_spot": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset", "free", "locked"],
            "properties": {
              "asset": { "type": "string" },
              "free": {
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              },
              "locked": {
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              },
              "value_usdt": {
                "anyOf": [
                  { "$ref": "#/$defs/decimal_string" },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "um_positions": {
          "type": "array",
          "items": { "$ref": "#/$defs/um_position" }
        },
        "total_value_usdt": {
          "description": "spot_value_usdt + unified net (accountEquity, else unified wallet gross).",
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "spot_value_usdt": {
          "description": "Σ(spot free+locked priced in USDT).",
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "unified_wallet_value_usdt": {
          "description": "Σ(unified totalWalletBalance priced); wallet gross, not net equity.",
          "anyOf": [
            { "$ref": "#/$defs/decimal_string" },
            { "type": "null" }
          ]
        },
        "pm_account": {
          "description": "Portfolio Margin account summary from GET /papi/v1/account (additive). Null fields when channel off or fetch failed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_equity_usdt",
            "actual_equity_usdt",
            "total_available_balance_usdt",
            "account_initial_margin_usdt",
            "account_maint_margin_usdt",
            "uni_mmr",
            "account_status",
            "total_debt_usdt",
            "leverage_ratio",
            "source"
          ],
          "properties": {
            "account_equity_usdt": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "actual_equity_usdt": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "total_available_balance_usdt": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "account_initial_margin_usdt": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "account_maint_margin_usdt": {
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "uni_mmr": {
              "description": "Unified maintenance margin ratio (equity / maint margin). Higher is safer.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "account_status": { "type": ["string", "null"] },
            "total_debt_usdt": {
              "description": "Priced sum of crossMarginBorrowed on unified balances.",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "leverage_ratio": {
              "description": "total_value_usdt / account_equity when both positive (wallet valuation vs equity).",
              "anyOf": [
                { "$ref": "#/$defs/decimal_string" },
                { "type": "null" }
              ]
            },
            "source": {
              "type": ["string", "null"],
              "description": "papi_v1_account when account endpoint contributed; null when unavailable."
            }
          }
        },
        "valuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["price_source", "priced_at"],
          "properties": {
            "price_source": { "type": "string" },
            "priced_at": { "type": ["string", "null"] }
          }
        },
        "checked_at": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] },
        "source_checked_at": {
          "description": "Fixed five-key per-source success-time metadata (v0.10, stage 2026-08-03-hedge-status-account-refresh-v1). Always emitted (all five keys present). Each value is the UTC ISO-8601 moment this service last successfully obtained AND wrote that account/valuation source into its cache, or null when it has never succeeded (cold start / PM capability absent for pm_account). A failure keeps the last-good value and its old time (does NOT advance). This is a source-read success clock, NOT a quote-freshness clock, a page-render time, or the snapshot publish time; it does not change checked_at / valuation.priced_at (the kept-back aggregate). price_map is valuation data and is included for completeness classification and the partial-source notice, not for a per-account panel title.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price_map",
            "unified_balances",
            "um_positions",
            "spot_balances",
            "pm_account"
          ],
          "properties": {
            "price_map": { "type": ["string", "null"], "format": "date-time" },
            "unified_balances": { "type": ["string", "null"], "format": "date-time" },
            "um_positions": { "type": ["string", "null"], "format": "date-time" },
            "spot_balances": { "type": ["string", "null"], "format": "date-time" },
            "pm_account": {
              "description": "null when the PM capability (GET /papi/v1/account) is absent; the key is still present.",
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "unavailable_sources": {
          "description": "Account sources this assembly did NOT obtain (F4, 2026-08-07). The judgement is the input being None -- the fetchers use None for disabled/failed and [] for 'read it, genuinely empty'. The `or []` degradation that follows would otherwise erase that distinction, leaving consumers unable to tell 'not read' from 'really nothing' -- which is how the positions table came to print an exchange-has-no-position claim over rows the account actually held. Always emitted; an empty array means every account source was obtained. Names mirror source_checked_at minus price_map (not an account source). An empty array must never be read as 'unknown'.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["unified_balances", "um_positions", "spot_balances", "pm_account"]
          }
        }
      }
    },
